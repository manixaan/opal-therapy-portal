{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(mkdir -p:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git check-ignore:*)",
      "Bash(git stash list)",
      "Bash(git worktree list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(node --check:*)",
      "Bash(node --version)",
      "Bash(node scripts/check-asset-pins.js:*)",
      "Bash(node migrate.js status)",
      "Bash(npx jest:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run migrate:status)",
      "Bash(npm ls:*)",
      "Bash(psql -l)"
    ],
    "ask": [
      "Bash(gh workflow run:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm run migrate)",
      "Bash(node migrate.js up:*)",
      "Bash(npm run test:e2e:*)",
      "Bash(dropdb:*)",
      "Bash(createdb:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.e2e)",
      "Read(./backend/.env)",
      "Read(./frontend/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/id_rsa*)",
      "Read(./deploy/staging-synthetic.local.txt)",
      "Read(./.local-documents/**)",
      "Bash(cat .env*)",
      "Bash(cat backend/.env*)",
      "Bash(cat deploy/staging-synthetic.local.txt)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git worktree remove --force:*)",
      "Bash(az:*)",
      "Bash(./deploy/:*)",
      "Bash(bash deploy/:*)",
      "Bash(sh deploy/:*)",
      "Bash(MIGRATE_ALLOW_PRODUCTION=true:*)",
      "Bash(npm publish:*)"
    ]
  }
}
