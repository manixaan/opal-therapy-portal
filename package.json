{
  "name": "opal-therapy-portal-e2e",
  "private": true,
  "description": "E2E harness for the Opal Therapy Portal (staging only). Backend app lives in backend/.",
  "scripts": {
    "setup": "node scripts/dev-setup.js",
    "start": "node backend/server.js",
    "dev": "npm --prefix backend run dev",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:local": "playwright test --config playwright.local.config.js",
    "tutorials:capture": "node scripts/capture-tutorial-screenshots.js",
    "content:export": "node backend/scripts/content-seed.js export",
    "content:import": "node backend/scripts/content-seed.js import",
    "content:status": "node backend/scripts/content-seed.js status"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.4.5"
  }
}
