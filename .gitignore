# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.npm/

# ── Environment / secrets (NEVER commit these) ───────────────────────────────
.env
.env.*
*.save
backend/.env
backend/.env.*
backend/*.save
frontend/.env
frontend/.env.*

# Allow .env.example files (templates with no real secrets)
!.env.example
!backend/.env.example
!frontend/.env.example

# ── Build / cache ─────────────────────────────────────────────────────────────
.next/
dist/
build/
coverage/
.cache/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Sensitive documents ───────────────────────────────────────────────────────
# Blanket-ignored so a clinical document can never be committed by accident.
*.docx
*.xlsx
*.pdf

# …except the report templates, which are application assets rather than
# documents. They contain only content controls and boilerplate — no client
# content — and the FCA/letter features cannot run without them: the blanket
# rule above silently excluded them when the feature was committed, which left
# three test suites unable to load and the generator with nothing to fill in.
!backend/fca/templates/*.docx

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── Test output ───────────────────────────────────────────────────────────────
junit.xml

# Transfer snapshots (binary archives stay out of git)
opal-scheduler-snapshot-*.zip
.claude/worktrees/
.local-documents/

# staging synthetic credentials (local only, never committed)
deploy/staging-synthetic.local.txt

# E2E credentials (never commit) — the .example template IS committed
.env.e2e
!.env.e2e.example
test-results/
playwright-report/
.playwright-mcp/
