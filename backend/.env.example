# ═══════════════════════════════════════════════════════════════════════════
#  Opal Therapy Scheduler — environment configuration
#
#  Copy to .env and fill in real values. NEVER commit .env.
#  Validation: env-validation.js warns in development and REFUSES to boot in
#  production/staging when critical values are missing or weak.
#  Per-variable behaviour is documented in handover/ENVIRONMENT_VARIABLES.md.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
# PORT: injected by Azure App Service in cloud environments. Local dev: 5001.
PORT=5001
# NODE_ENV: development | staging | production
# staging/production activate: strict env validation, strict OAuth state,
# secure cookies, strict CSRF, hidden error details, TLS cert verification.
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=therapy_scheduler
DB_USER=postgres
DB_PASSWORD=REPLACE_ME
# Integration tests ALWAYS run against ${DB_NAME}_test and refuse anything else.

# ── Sessions & token encryption (CRITICAL in production) ───────────────────
# ≥32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_48_RANDOM_BYTES_HEX
# Exactly 64 hex chars (32 bytes) — AES-256-GCM for stored OAuth tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Missing in development ⇒ tokens stored in PLAINTEXT with a warning.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# ── Onboarding field encryption ─────────────────────────────────────────────
# Exactly 64 hex chars (32 bytes) — AES-256-GCM for tax file numbers, bank
# details and identity document numbers collected during employee onboarding.
#
# SEPARATE FROM TOKEN_ENCRYPTION_KEY ON PURPOSE. OAuth tokens are rotated
# routinely and can be re-obtained by re-authenticating; HR ciphertext cannot.
# Sharing one key would mean an OAuth key rotation permanently destroyed every
# stored tax and bank detail.
#
# Behaviour when unset:
#   development / test  → falls back to TOKEN_ENCRYPTION_KEY, else stores a
#                         clearly-marked DEV-PLAINTEXT value.
#   staging / production→ onboarding REFUSES to collect tax or bank details
#                         (503). Storing a tax file number in clear is worse
#                         than not collecting it, so this fails closed.
ONBOARDING_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
# Set only during a key rotation: the previous key, so reads keep working
# while backend/scripts re-encrypt. Remove once the rotation is complete.
# ONBOARDING_ENCRYPTION_KEY_PREVIOUS=

# ── Microsoft OAuth (Azure App Registration) ────────────────────────────────
MICROSOFT_CLIENT_ID=REPLACE_ME
MICROSOFT_CLIENT_SECRET=REPLACE_ME
# Must EXACTLY match a redirect URI configured on the app registration.
MICROSOFT_REDIRECT_URI=http://localhost:5001/auth/oauth/callback
# Azure directory (tenant). Unset ⇒ falls back to the development tenant.
MICROSOFT_TENANT_ID=REPLACE_WITH_TENANT_GUID

# ── Splose ──────────────────────────────────────────────────────────────────
SPLOSE_API_KEY=REPLACE_ME
SPLOSE_BASE_URL=https://api.splose.com

# ── Google Maps (travel time, geocoding, Places) ───────────────────────────
# Key needs: Routes API, Places API (New), Geocoding API, Maps JavaScript API.
# Missing ⇒ /api/maps/* return 503 and travel features degrade gracefully.
GOOGLE_MAPS_API_KEY=REPLACE_ME

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Unset in development ⇒ verification/invite/reset links are printed to the
# server console instead of being emailed (safe local workflow).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Opal Therapy <noreply@example.com>"
# Base URL used inside emailed links (verify/reset/invite).
APP_BASE_URL=http://localhost:5001

# ── Registration allowlist ──────────────────────────────────────────────────
# Read at process start (restart after changing). A fresh deployment MUST set
# ALLOWED_EMAILS to the first owner's address or nobody can ever register.
ALLOWED_DOMAINS=
ALLOWED_EMAILS=

# ── CORS / CSRF origin allowlist ────────────────────────────────────────────
# Comma-separated. Production must list the real portal origin.
ALLOWED_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# ── Outlook webhooks (real-time sync; needs a public HTTPS URL) ────────────
# Leave blank on localhost — 90-second polling covers sync. When set,
# WEBHOOK_CLIENT_STATE becomes REQUIRED and must not be the historical default.
WEBHOOK_BASE_URL=
WEBHOOK_CLIENT_STATE=

# ── Sync deletion-safety thresholds (Phase 3 data-loss controls) ───────────
# Max events one automatic sync cycle may delete, and max % of linked local
# events. Exceeding either blocks the batch, audits, and notifies owners.
SYNC_MAX_AUTO_DELETE=25
SYNC_MAX_DELETE_PERCENT=30

# ── Document storage backend (Phase 7) ─────────────────────────────────────
# db    (default) — file bytes stay base64 in Postgres (pilot behaviour)
# local           — files under DOCUMENT_STORAGE_PATH (dev/self-host)
# blob            — private Azure Blob Storage (staging/production target;
#                   requires @azure/storage-blob installed and the AZURE_* vars)
# Downloads are ONLY served through the authenticated
# GET /api/profile/documents/:id/download route — never public URLs.
DOCUMENT_STORAGE_BACKEND=db
DOCUMENT_STORAGE_PATH=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=employee-documents

# ── Migration safety ────────────────────────────────────────────────────────
# `npm run migrate` refuses to run when NODE_ENV=production unless the deploy
# pipeline sets this to true (or a deliberate manual run passes --yes).
MIGRATE_ALLOW_PRODUCTION=

# ── Observability (Phase 8) ─────────────────────────────────────────────────
# LOG_LEVEL: debug | info | warn | error (default: info in production, debug otherwise)
# Application Insights activates ONLY when the connection string is set AND the
# applicationinsights SDK is installed (deploy pipeline does this — not needed
# locally). Telemetry is redacted before leaving the process.
LOG_LEVEL=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Database TLS (Azure) ────────────────────────────────────────────────────
# Azure Database for PostgreSQL requires TLS — set true in staging/production.
# Leave unset for local plaintext development connections.
DB_SSL=

# ── Staged-integration feature flags (Phase 10) ─────────────────────────────
# Unset = ON in development/test, OFF in staging/production (fail-safe).
# Turn each on deliberately, per environment, as the pilot stages advance:
#   Stage 1 (read-only mirror): all three false
#   Stage 2 (write-back):       ENABLE_OUTLOOK_WRITE / ENABLE_SPLOSE_WRITE true
#   Stage 3 (full sync):        ENABLE_AUTOMATIC_REMOTE_DELETE true
ENABLE_OUTLOOK_WRITE=
ENABLE_SPLOSE_WRITE=
ENABLE_AUTOMATIC_REMOTE_DELETE=

# ── Accounting / Xero module (owner-only finance) ───────────────────────────
# OAuth app credentials (Key Vault refs in Azure). Read-only by default.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
XERO_WEBHOOK_KEY=
# Read flags default ON (module works read-only out of the box).
# EVERY write flag fails closed in ALL environments — only the literal
# string 'true' enables it, and writes also require ENABLE_XERO_WRITE=true.
ENABLE_XERO_READ=true
ENABLE_FINANCE_DASHBOARD=true
ENABLE_XERO_WRITE=false
ENABLE_XERO_DRAFT_INVOICE_CREATE=false
ENABLE_XERO_APPROVE_INVOICE=false
ENABLE_XERO_SEND_INVOICE=false
ENABLE_XERO_PAYMENT_CREATE=false
ENABLE_XERO_AUTO_RECONCILIATION=false
ENABLE_XERO_WEBHOOKS=false

# ── WHODAS 2.0 digital assessment ────────────────────────────────────────────
# WHO Disability Assessment Schedule 2.0, 36-item version, administered
# electronically (interviewer / self / proxy).
#
# Fails closed in EVERY environment, development included — only the exact
# string 'true' enables it, and every route 404s otherwise. This is the
# licensing gate: WHODAS 2.0 is a WHO instrument, and production release is
# conditional on Opal Therapy completing WHO's registration and the checklist
# in docs/whodas/03_LICENSING_COMPLIANCE.md. Do not set this in production
# until every box in that checklist is ticked.
ENABLE_WHODAS_ASSESSMENT=false

# ── Resource Hub (Phase R1) ─────────────────────────────────────────────────
ENABLE_RESOURCE_HUB=true
ENABLE_RESOURCE_CLIENT_SUGGESTIONS=false
ENABLE_RESOURCE_AI_SUGGESTIONS=false
ENABLE_RESOURCE_EXTERNAL_SHARING=false

# ── OPAL AI BOUNDARY ────────────────────────────────────────────────────────
# EVERY AI feature in the backend goes through backend/ai/ai-gateway.js. No
# module may import an AI SDK or call a vendor endpoint directly — enforced by
# tests/ai-gateway-boundary.test.js, which fails the build if it happens.
#
# Inference runs on Amazon Bedrock in AUSTRALIAN REGIONS ONLY. Clinical
# narrative is health information; keeping inference onshore avoids a
# cross-border disclosure under APP 8 and s 16C accountability. Rationale and
# AWS setup steps: docs/mobile/CLINICAL_AI_PROVIDER_DECISION.md.

# ── Required settings (ALL SIX, or no Bedrock call happens) ────────────────
#
# backend/ai/aws/bedrock-config.js is the single owner of these and validates
# every one. None has a default: a missing setting stops the call rather than
# letting the code choose a destination nobody picked.
#
# This block previously named AI_AWS_REGION, which the code has not read since
# the config owners were consolidated, and omitted AWS_ROLE_ARN and
# AZURE_BEDROCK_AUDIENCE entirely — so a deployment configured faithfully from
# this template had no working AI and no error explaining why.

# Source region for every AI call. Must be ap-southeast-2 (Sydney) or
# ap-southeast-4 (Melbourne). Any other value disables AI entirely rather
# than routing offshore — there is no fallback provider.
AWS_REGION=ap-southeast-2

# The AWS role the App Service assumes through federation. Validated as an IAM
# role ARN. NOT a secret — an ARN names a resource, it does not grant one — but
# it identifies the account, so treat it as configuration, not documentation.
AWS_ROLE_ARN=

# The Entra application's Application ID URI. It becomes the `aud` claim of the
# issued token, and AWS matches it against the role's trust policy. Wrong value
# ⇒ STS refuses, which is the correct outcome and not something to work around.
AZURE_BEDROCK_AUDIENCE=

# Optional. Appears as the session name in CloudTrail, so it must never contain
# anything about a person. Defaults to 'opal-portal-staging'.
AWS_ROLE_SESSION_NAME=

# ── Bedrock guardrail (REQUIRED for any real clinical generation) ───────────
#
# Both must be set or the Bedrock provider REFUSES TO TRANSMIT. That is the
# point: a call sent without these headers still succeeds and returns a normal,
# usable clinical draft, with nothing in the response, the audit row or the
# therapist's screen indicating the safety layer was skipped. There is no later
# moment at which the omission becomes visible, so an absent guardrail is
# treated exactly like a thrown kill switch — generation stops and the phone is
# told "unavailable".
#
# Values come from the AWS console (Bedrock → Guardrails). Use the GENERATED
# identifier, not the display name: 'OpalClinicalAIGuardrail' is the name, and
# the identifier AWS generates is a short lowercase-alphanumeric string (or the
# full ARN). The display name is refused by the shape check. They are identifiers,
# not secrets, but they differ per account and must never be hardcoded.
# Setting one without the other is refused as a misconfiguration.
#
# Version: the published version number, e.g. 1. DRAFT is accepted for tuning
# and reported as mutable — do not leave it on a build therapists rely on,
# because its behaviour can change under the running app with no deployment.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# ── Inference profile ───────────────────────────────────────────────────────
#
# Optional. Approved models live in backend/ai/ai-model-registry.js and are
# selected per feature in backend/ai/ai-policy.js — the registry remains the
# only place a model id may be WRITTEN. This variable lets a deployment choose
# a different approved profile without a code change, because profile
# availability differs per AWS account.
#
# It is validated, not trusted: a value that is not an `au.` Australian geo
# profile, or that names a Covered Model, is REFUSED outright rather than
# quietly falling back to the default. `global.` routes worldwide and `apac.`
# also reaches Tokyo, Seoul, Osaka, Mumbai, Hyderabad and Singapore, so neither
# can be introduced here.
#
# REQUIRED. This is the base profile and every tier uses it unless given one of
# its own below.
BEDROCK_MODEL_ID=

# ── Per-tier profiles (optional) ───────────────────────────────────────────
#
# The registry declares two clinical tiers and the policies choose between them
# deliberately: case notes default to `clinical_complex` for report-grade
# fidelity, everything else to `clinical_standard`. Until these existed, BOTH
# resolved through BEDROCK_MODEL_ID above — so the choice was made in policy and
# then silently not carried out. The audit row was still accurate, which is
# precisely why it went unnoticed.
#
# Leave both blank and behaviour is exactly as before: one profile for
# everything, and the boot log says so. Set one and that tier uses it. Each is
# validated by the same rules as the base, and an override that fails them is
# REFUSED rather than falling back — invoking a different model than the one an
# operator explicitly named is worse than not starting.
#
# The name is derived from the registry key: BEDROCK_MODEL_ID_<KEY UPPERCASED>.
BEDROCK_MODEL_ID_CLINICAL_STANDARD=
BEDROCK_MODEL_ID_CLINICAL_COMPLEX=

# Per-feature switches. Each is fail-closed and additionally requires the
# gateway configuration above to satisfy that feature's policy.
CLINICAL_NOTE_AI_ENABLED=false
OPA_AI_ENABLED=false

# Optional per-feature tuning.
CLINICAL_NOTE_MAX_TOKENS=3000
CLINICAL_NOTE_TIMEOUT_MS=60000
OPA_MAX_OUTPUT_TOKENS=1024
OPA_REQUEST_TIMEOUT_MS=25000

# AWS credentials are NOT set here, and should not be set anywhere in
# production. The target is Azure Managed Identity → Entra → AWS STS
# AssumeRoleWithWebIdentity, giving short-lived credentials with no permanent
# AWS key in application configuration. Locally the standard AWS chain
# applies. No module in backend/ai/ reads or logs a credential.
