 {
  "id": "6d59942c-0019-4f10-8c26-30fd636de677",
  "organisation_id": null,
  "title": "New Starter — Occupational Therapist",
  "description": "Core induction for every occupational therapist joining Opal Therapy.",
  "category": "induction",
  "status": "active",
  "draft_content": {
   "sections": [
    {
     "key": "s-cc0c0377",
     "items": [
      {
       "key": "i-51d60b22",
       "body": "Welcome to the team! This induction walks you through how Opal Therapy runs: our values, the people you will work with, and the systems you will use every day.\n\nWork through each section in order — your progress saves automatically.",
       "type": "content",
       "title": "Welcome and how we work",
       "minutes": 5,
       "required": true
      },
      {
       "key": "i-b935f6a2",
       "body": "Who does what at Opal Therapy, who to ask about scheduling, clinical questions, and equipment.",
       "type": "content",
       "title": "Organisational structure",
       "minutes": 5,
       "required": true
      },
      {
       "key": "i-61c16665",
       "body": "Read the code of conduct below, then confirm your acknowledgement.",
       "type": "acknowledgement",
       "title": "Code of conduct",
       "minutes": 10,
       "required": true,
       "ack_statement": "I have read and understood the Opal Therapy Code of Conduct and agree to work in accordance with it."
      }
     ],
     "title": "Welcome to Opal Therapy"
    },
    {
     "key": "s-08356feb",
     "items": [
      {
       "key": "i-d993f241",
       "body": "Client information is health information. This module covers what you may collect, where it must live, and what must never leave our systems.",
       "type": "content",
       "title": "Privacy and confidentiality",
       "minutes": 10,
       "required": true
      },
      {
       "key": "i-1dd2460e",
       "body": "Confirm the privacy undertaking below.",
       "type": "acknowledgement",
       "title": "Privacy undertaking",
       "minutes": 3,
       "required": true,
       "ack_statement": "I understand my privacy and confidentiality obligations, including that client information is only accessed for clinical purposes and never stored outside approved systems."
      },
      {
       "key": "i-a1fd0452",
       "body": "A short check of the privacy module.",
       "quiz": {
        "questions": [
         {
          "options": [
           "Send it — they are family",
           "Decline and escalate to the practice owner before releasing anything",
           "Read it to them over the phone"
          ],
          "question": "A client’s parent asks for a copy of a report about the other parent’s session. What do you do?",
          "correctIndex": 1
         },
         {
          "options": [
           "In approved practice systems only",
           "On my personal laptop for convenience",
           "In a private notebook"
          ],
          "question": "Where may session notes be stored?",
          "correctIndex": 0
         }
        ],
        "passThreshold": 80
       },
       "type": "quiz",
       "title": "Privacy knowledge check",
       "minutes": 5,
       "required": true
      }
     ],
     "title": "Privacy and compliance"
    },
    {
     "key": "s-d8c67304",
     "items": [
      {
       "key": "i-0e77ee3f",
       "body": "Complete your profile in the portal: display name, phone, work locations, and upload your credentials.",
       "type": "task",
       "title": "Set up your portal profile",
       "minutes": 10,
       "required": true
      },
      {
       "key": "i-be22ad51",
       "body": "How appointments, travel blocks and the logbook work — and what to check before you drive.",
       "type": "content",
       "title": "Scheduling and travel",
       "minutes": 10,
       "required": true
      }
     ],
     "title": "Working here"
    }
   ]
  },
