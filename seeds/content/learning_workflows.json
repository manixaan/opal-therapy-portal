  "title": "New Graduate Occupational Therapist",
  "description": "Extended induction for new graduate OTs: supervision, clinical documentation and NDIS fundamentals.",
  "category": "induction",
  "status": "active",
  "draft_content": {
   "sections": [
    {
     "key": "s-f5be8cdd",
     "items": [
      {
       "key": "i-8e2b8cd1",
       "body": "Your supervision schedule, who your supervisor is, and how to raise clinical questions between sessions.",
       "type": "content",
       "title": "Your supervision structure",
       "minutes": 5,
       "required": true
      },
      {
       "key": "i-40fc1497",
       "body": "Plans, goals, supports and how OT services fit into a participant’s NDIS plan.",
       "type": "content",
       "title": "NDIS fundamentals",
       "minutes": 15,
       "required": true
      }
     ],
     "title": "Foundations"
    },
    {
     "key": "s-0992d8ed",
     "items": [
      {
       "key": "i-e97370a5",
       "body": "What a defensible session note contains, and what does not belong in one.",
       "type": "content",
       "title": "Session notes that stand up",
       "minutes": 10,
       "required": true
      },
      {
       "key": "i-2cfa7db1",
       "body": "",
       "quiz": {
        "questions": [
         {
          "options": [
           "Within the practice’s documentation window, as soon as practicable",
           "At the end of the month",
           "Only if something notable happened"
          ],
          "question": "When should a session note be written?",
          "correctIndex": 0
         }
        ],
        "passThreshold": 80
       },
       "type": "quiz",
       "title": "Documentation knowledge check",
       "minutes": 5,
       "required": true
      },
      {
       "key": "i-efcef326",
       "body": "Confirm you have read the documentation standard.",
       "type": "acknowledgement",
       "title": "Documentation standard",
       "required": true,
       "ack_statement": "I have read the clinical documentation standard and will document sessions in accordance with it."
      }
     ],
     "title": "Clinical documentation"
    }
   ]
  },
